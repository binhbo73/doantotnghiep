# ====================================
# 🔧 LOCAL DEVELOPMENT ENVIRONMENT
# ====================================
# Sao chép file này thành .env.local (GIT IGNORED)
# Sử dụng khi chạy LOCAL Django (không phải trong Docker)

# Database Configuration - LOCAL ONLY
POSTGRES_DB=rag_system
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Security
SECRET_KEY=change-me-to-a-long-random-django-secret-key
DEBUG=True
ALLOWED_HOSTS='["localhost","127.0.0.1"]'

# App
APP_NAME=RAG System API
APP_VERSION=1.0.0

# CORS
CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://localhost:8000"]'

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads

# Qdrant (Vector Database) - LOCAL
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=change-me-qdrant-api-key
QDRANT_PERSIST_DIRECTORY=./qdrant_data

# AI Model Configuration (Local Ollama)
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2:1.5b
EMBEDDING_BACKEND=flag
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto

# Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_SENDER=noreply@rag-system.local
APP_URL=http://localhost:3000

# Seed scripts (local development only; use unique non-production values)
SEED_ADMIN_PASSWORD=change-me-seed-admin-password
SEED_MANAGER_PASSWORD=change-me-seed-manager-password
SEED_USER_PASSWORD=change-me-seed-user-password
SEED_EXTENDED_USER_PASSWORD=change-me-seed-extended-user-password
CHECK_PASSWORD_USERNAME=admin
CHECK_PASSWORD_CANDIDATE=change-me-password-candidate
