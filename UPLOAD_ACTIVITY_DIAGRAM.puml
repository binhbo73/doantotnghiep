@startuml
title Quy trình tải lên và lập chỉ mục tài liệu

skinparam defaultFontSize 15
skinparam ranksep 22
skinparam nodesep 18     
skinparam activity {
  BackgroundColor white
  BorderColor #4B5563
  DiamondBackgroundColor #FEF3C7
  DiamondBorderColor #92400E
}

start

:Chọn file và\nphạm vi truy cập;

:Kiểm tra đăng nhập,\nquyền và file;

if (Hợp lệ?) then (Có)
  :Lưu file và tạo\nDocument (pending);
else (Không)
  :Trả thông báo lỗi;
  stop
endif

if (Có Celery?) then (Có)
  :Đưa vào hàng đợi;
else (Không)
  :Xử lý đồng bộ;
endif

:Trích xuất nội dung\nvà cấu trúc tài liệu;

:Chia chunk và\ntạo embedding;

:Lưu chunk vào PostgreSQL\nvà vector vào Qdrant;

:Đánh dấu completed\nvà base_ready;

:Xử lý nền tùy chọn:\nảnh/OCR và RAPTOR;

:Tài liệu sẵn sàng\ncho tìm kiếm và chat;

stop
@enduml
