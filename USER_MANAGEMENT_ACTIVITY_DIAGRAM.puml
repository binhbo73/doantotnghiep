@startuml
title Quản lý người dùng và phân quyền

skinparam defaultFontSize 15
skinparam ranksep 22
skinparam nodesep 18
skinparam activity {
  BackgroundColor white
  BorderColor #4B5563
  DiamondBackgroundColor #DBEAFE
  DiamondBorderColor #1E40AF
}

start

:Quản trị viên nhập thông tin\nngười dùng, phòng ban và vai trò;

:Kiểm tra JWT và\nquyền quản lý người dùng;

if (Đủ quyền?) then (Có)
  :Kiểm tra dữ liệu và\ntài khoản trùng lặp;
else (Không)
  :Từ chối thao tác;
  stop
endif

if (Dữ liệu hợp lệ?) then (Có)
  :Tạo hoặc cập nhật\nAccount và UserProfile;
else (Không)
  :Trả thông báo lỗi;
  stop
endif

:Gán phòng ban,\nvai trò và quyền;

:Thiết lập trạng thái\nactive / blocked / inactive;

:Ghi nhật ký kiểm toán;

:Trả kết quả và cập nhật\ndanh sách người dùng;

stop
@enduml
